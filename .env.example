# Google AdSense Configuration
# Get these values from your Google AdSense account: https://www.google.com/adsense

# AdSense Publisher Client ID (e.g., ca-pub-1234567890123456)
VITE_ADSENSE_CLIENT_ID=

# AdSense Ad Unit Slot ID (e.g., 1234567890)
VITE_ADSENSE_SLOT_ID=

# Note: If these values are not set, ads will not be displayed
# The app will work normally without ads if these are empty
